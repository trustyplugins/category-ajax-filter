{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Category AJAX Filter (Free) — Legacy + Builder Demos",
    "description": "Installs CAF free, seeds legacy and builder filters with category checkbox terms, and opens the demo hub.",
    "author": "Trusty Plugins"
  },
  "landingPage": "/caf-playground/",
  "login": true,
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "CAF Free Playground",
        "blogdescription": "Legacy + builder filter demos with category terms",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/trustyplugins/category-ajax-filter",
        "ref": "playground",
        "refType": "branch"
      },
      "options": {
        "activate": true,
        "targetFolderName": "category-ajax-filter"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require_once WP_PLUGIN_DIR . '/category-ajax-filter/includes/playground/seed-demo.php'; caf_playground_seed_demo(); ?>"
    }
  ]
}
